# Copy to .env.commerceops when you want to override the compose file.
# scripts/start-commerceops.sh does not read this file. It uses a repo-local SQLite path.

COMMERCEOPS_HOST=0.0.0.0
COMMERCEOPS_PORT=8077
COMMERCEOPS_AUTO_SEED=1
COMMERCEOPS_DATABASE_URL=sqlite:////data/commerceops.db
COMMERCEOPS_NOTIFY_LOG=/data/notifications.jsonl
COMMERCEOPS_EVAL_DIR=/data/evals

# Leave unset for a dry-run Feishu card.
# FEISHU_WEBHOOK_URL=

# Used by the OpenDot Node process, not inside the container.
# COMMERCEOPS_API_URL=http://127.0.0.1:8077
