# Shared by scripts/start-commerceops.sh and docker compose.
# Copy to .env.commerceops before changing the signing secret.

COMMERCEOPS_PORT=8077
COMMERCEOPS_AUTO_SEED=1
COMMERCEOPS_SIGNING_SECRET=local-dev-change-me-please
COMMERCEOPS_WORKSPACE_ID=ws-demo

# The local script forces 127.0.0.1 unless COMMERCEOPS_ALLOW_PUBLIC_BIND=1.
# Compose publishes only 127.0.0.1:8077 and sets the container database itself.
# COMMERCEOPS_HOST=127.0.0.1
# COMMERCEOPS_DATABASE_URL=sqlite:///./services/commerceops/commerceops.db
# COMMERCEOPS_API_URL=http://127.0.0.1:8077
# FEISHU_WEBHOOK_URL=
